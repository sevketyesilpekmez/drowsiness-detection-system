
VIDEO_SOURCE=0
# Kamerasız/Linux dışı ortamda test için:
# VIDEO_SOURCE=sample_data/drowsy/docker_smoke_test.mp4

# false: DetectionEngine hiç başlamaz, kamera açılmaz (testlerin varsayılanı).
# true: gerçek çalıştırma için (docker compose up / python run.py).
ENABLE_DETECTION_ENGINE=true

# DETECTION_BACKEND: hangi tespit hattı kullanılsın.
#   yolo_pytorch: YOLO (person) + Haar cascade (göz bölgesi) + PyTorch
#     (göz sınıflandırma) — varsayılan. Ağırlıklar eksikse mediapipe'a düşer.
#   mediapipe: MediaPipe Face Mesh + EAR — eğitim gerektirmeyen yedek mod.
DETECTION_BACKEND=yolo_pytorch

# true iken yolo_pytorch kurulamazsa mediapipe'a otomatik düşülür (geliştirme
# için kullanışlı). Teslim/sunum öncesi false yapın: bu durumda düşülmez,
# /api/detection/status kalıcı olarak MODEL_ERROR gösterir (bkz. README).
ALLOW_DETECTION_FALLBACK=false

# yolov8n.pt yerel bulunamazsa ultralytics ilk çalıştırmada indirir.
# weights/ klasörüne koyup YOLO_MODEL_PATH=weights/yolov8n.pt yapılabilir.
YOLO_MODEL_PATH=yolov8n.pt
YOLO_CONFIDENCE_THRESHOLD=0.5
# Inference öncesi kareyi letterbox'layacağı kare kenar uzunluğu. 640 =
# ultralytics'in kendi varsayılanı. Düşürmek CPU'da FPS kazandırabilir.
YOLO_IMGSZ=640

CAMERA_WIDTH=640
CAMERA_HEIGHT=480

# torch/ultralytics cihazı: cpu (her makinede çalışır), mps (Apple Silicon
# GPU), cuda:0 (NVIDIA GPU).
TORCH_DEVICE=cpu

# Başını öne eğince (uyuklama pozu) Haar'ın göz bulmakta zorlandığı
# görüldü (bkz. README "Baş eğikliği"). YOLO ve PyTorch sınıflandırıcı
# aynen kaldı, yalnızca "göz nerede" adımı değişti.
#   mediapipe (varsayılan): Face Mesh landmark'larından göz bölgesi bulur,
#     baş pozuna dayanıklı. Başarısız olursa Haar'a düşer.
#   haar: eski davranış, yalnızca Haar cascade — biraz daha yüksek FPS.
EYE_LOCATOR_BACKEND=mediapipe
# MediaPipeEyeLocator'ın ham landmark kutusunu her yöne ne kadar
# genişleteceği. 0.4 makul bir başlangıç değeri.
EYE_LANDMARK_PADDING_RATIO=0.4

# scripts/train_eye_classifier.py'nin ürettiği checkpoint yolu.
EYE_CLASSIFIER_WEIGHTS_PATH=weights/eye_classifier.pth

# Haar'ın ağzı göz sanmasını azaltan ayarlar (bkz. eye_region_locator.py).
# EYE_SEARCH_HEIGHT_RATIO=0.70: kamerayla karşılaştırmalı test sonucu
# seçildi (0.55'e göre belirgin daha iyi, bkz. README).
EYE_SEARCH_HEIGHT_RATIO=0.70
# Zamansal yumuşatma penceresi. Bu ayarlar önce KARE cinsindendi;
# uçtan uca ölçüm kare biriminin sistemin davranışını makine hızına
# bağladığını gösterdi (5->30 FPS aralığında alarm gecikmesi 0.79 sn
# kayıyordu). Varsayılanlar eski kare değerlerinin ~8 FPS'teki
# karşılıkları — mevcut davranışı korur.
EYE_SMOOTHER_WINDOW_SECONDS=0.9
EYE_SMOOTHER_CLOSED_RATIO_THRESHOLD=0.6
EYE_SMOOTHER_MISSING_TOLERANCE_SECONDS=0.25
EYE_SMOOTHER_MINIMUM_VALID_SECONDS=0.35
SINGLE_EYE_CONFIDENCE_THRESHOLD=0.80

# Kadrajda kişi varken göz durumunun ÖLÇÜLEMEDİĞİ serinin kaç saniyeye
# kadar tolere edileceği. Aşılınca sistem UNVERIFIABLE'a geçer — sürücü
# yüzünü çevirdiğinde (gövdesi hâlâ görünürken) "uyanık" raporlanmasını
# engeller. 0 = hiç tolerans yok.
#
# Eskiden EYE_LOCATOR_MISS_TOLERANCE'tı ve KARE sayıyordu; bir karenin
# süresi FPS'e bağlı olduğu için aynı değer 30 FPS'te 67 ms, 5 FPS'te
# 400 ms anlamına geliyordu.
EYE_MEASUREMENT_GRACE_SECONDS=0.35

# Kamera çözünürlüğü düşükken sabit piksel minSize'ın tutarsız davranma
# riski var. Bu ikisi varsayılan olarak kapalı, denemek istersen açın.
# EYE_ADAPTIVE_MIN_SIZE_ENABLED=true
# EYE_ADAPTIVE_MIN_SIZE_WIDTH_RATIO=0.12
# EYE_ADAPTIVE_MIN_SIZE_HEIGHT_RATIO=0.08
# EYE_SPLIT_LEFT_RIGHT=true

# 2.5: gerçek kamerayla yapılan canlı testte kararlaştırılan eşik.
DROWSINESS_SECONDS=2.5

# Göz kapalı serisi sürerken tek karelik bir "açık" okuması ya da kısa
# süreli bir "yüz bulunamadı" bu süre boyunca (saniye) birikmiş süreyi
# sıfırlamaz. 0.0 = eski davranış. Bkz. README "Zaman toleransı".
CLOSED_EYES_GRACE_PERIOD_SECONDS=0.3

EAR_THRESHOLD=0.22

# Aynı alarmın en az kaç saniyede bir tekrar tetiklenebileceği. 0 veya
# negatif değere izin verilmez.
ALARM_COOLDOWN_SECONDS=5.0

# Stream'deki JPEG frame'in üzerine göz noktaları + EAR değeri çizilsin mi.
DRAW_LANDMARKS=true

CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Yalnızca `python run.py` ile yerel çalıştırmayı etkiler (docker'da
# gunicorn kullanılıyor). Flask'in debug modu, hata sayfası üzerinden
# sunucuda kod çalıştırılabilen interaktif bir konsol açar ve uygulama
# 0.0.0.0 dinlediği için bu konsol ağdaki diğer makinelere de görünür
# olur — bu yüzden varsayılan kapalı. Geliştirirken açmak için:
# FLASK_DEBUG=true
